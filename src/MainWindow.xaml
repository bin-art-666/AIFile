<Window x:Class="AIFile.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AIFile">
    <Grid x:Name="Root" Background="Transparent">
        <Grid.Resources>
            <DataTemplate x:Key="PlaceTemplate" x:DataType="local:FilePlace">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,0">
                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" FontFamily="Segoe Fluent Icons"/>
                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="GridEntry" x:DataType="local:FileEntry">
                <ContentControl CanDrag="True" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Padding="0" Background="Transparent" ToolTipService.ToolTip="{x:Bind Path}"
                                Visibility="{x:Bind GridItemVisibility}"
                                Loaded="FileGripLoaded" DragStarting="StartFileDrag" DropCompleted="FileDragCompleted">
                    <StackPanel Spacing="4" Padding="6" Width="60">
                        <local:FileGlyph Entry="{x:Bind}" IconSize="36"/>
                        <TextBlock Text="{x:Bind Name}" FontSize="12" LineHeight="15" Height="30" TextAlignment="Center"
                                   LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </ContentControl>
            </DataTemplate>
            <DataTemplate x:Key="ListEntry" x:DataType="local:FileEntry">
                <Grid ColumnSpacing="8" Padding="6,3" Background="Transparent" ToolTipService.ToolTip="{x:Bind Path}"
                      CanDrag="True" Loaded="FileGripLoaded" DragStarting="StartFileDrag" DropCompleted="FileDragCompleted">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="116"/>
                        <ColumnDefinition Width="58"/>
                    </Grid.ColumnDefinitions>
                    <local:FileGlyph Entry="{x:Bind}" IconSize="22"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12"/>
                    <TextBlock Grid.Column="2" Text="{x:Bind TypeLabel}" FontSize="12" Opacity=".72" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{x:Bind ModifiedLabel}" FontSize="12" Opacity=".72" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="{x:Bind SizeLabel}" FontSize="12" Opacity=".72" VerticalAlignment="Center" TextAlignment="Right"/>
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid x:Name="TitleRow" Margin="8,6,8,0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="NavigationButtons" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"/>
            <StackPanel x:Name="CaptionButtons" Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"/>
        </Grid>
        <StackPanel Grid.Row="1" Spacing="6" Margin="8,6,8,0">
            <Grid>
                <BreadcrumbBar x:Name="Breadcrumbs" VerticalAlignment="Center" ItemClicked="CrumbClicked"
                               AutomationProperties.Name="目录路径"/>
                <TextBox x:Name="Address" PlaceholderText="输入目录路径" AutomationProperties.Name="地址栏"
                         Visibility="Collapsed" VerticalAlignment="Center" KeyDown="AddressKeyDown" LostFocus="AddressUnfocused"/>
            </Grid>
            <StackPanel x:Name="SearchBar" Spacing="4" Visibility="Collapsed">
                <AutoSuggestBox x:Name="Search" Margin="2,0" PlaceholderText="搜索文件" QueryIcon="Find"
                                AutomationProperties.Name="搜索文件" TextChanged="SearchChanged" QuerySubmitted="SearchSubmitted"/>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="2,0">
                    <CheckBox x:Name="SearchSubfolders" Content="包含子文件夹" Checked="SearchScopeChanged" Unchecked="SearchScopeChanged"/>
                    <CheckBox x:Name="SearchImageText" Content="搜索图片文字" Checked="SearchScopeChanged" Unchecked="SearchScopeChanged"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <Grid Grid.Row="2" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="PlacesPanel" Width="144" Margin="10,4,0,4" Visibility="Collapsed" CornerRadius="8"
                    Background="{ThemeResource HaloCardBrush}">
                <ListView x:Name="Places" Padding="4" IsItemClickEnabled="True" SelectionMode="Single"
                          ItemClick="PlaceClicked" ItemTemplate="{StaticResource PlaceTemplate}" AutomationProperties.Name="位置"/>
            </Border>
            <Grid x:Name="FilesHost" Grid.Column="1" AllowDrop="True" DragOver="FilesDragOver" DragLeave="FilesDragLeave"
                  Drop="FilesDrop" Background="Transparent">
                <GridView x:Name="Cards" Padding="10" Background="Transparent" ItemTemplate="{StaticResource GridEntry}"
                          SelectionMode="Extended" IsMultiSelectCheckBoxEnabled="False" IsItemClickEnabled="True"
                          ContainerContentChanging="FileContainerChanging" SelectionChanged="FileSelectionChanged"
                          DoubleTapped="FilesDoubleTapped" RightTapped="FilesRightTapped"
                          ContextRequested="FilesContextRequested" AutomationProperties.Name="文件网格">
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Width" Value="60"/>
                            <Setter Property="Height" Value="82"/>
                            <Setter Property="Margin" Value="6,4"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="MinWidth" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </GridView.ItemContainerStyle>
                </GridView>
                <ListView x:Name="Rows" Visibility="Collapsed" Padding="10" Background="Transparent" ItemTemplate="{StaticResource ListEntry}"
                          SelectionMode="Extended" IsMultiSelectCheckBoxEnabled="False" IsItemClickEnabled="True"
                          ContainerContentChanging="FileContainerChanging" SelectionChanged="FileSelectionChanged"
                          DoubleTapped="FilesDoubleTapped" RightTapped="FilesRightTapped"
                          ContextRequested="FilesContextRequested" AutomationProperties.Name="文件列表">
                    <ListView.Header>
                        <Grid x:Name="ListHeader" ColumnSpacing="8" Margin="12,0,12,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="116"/>
                                <ColumnDefinition Width="58"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1" Tag="Name" Click="SortHeaderClicked" Content="名称" Padding="5,2"/>
                            <Button Grid.Column="2" Tag="Type" Click="SortHeaderClicked" Content="类型" Padding="5,2"/>
                            <Button Grid.Column="3" Tag="Modified" Click="SortHeaderClicked" Content="修改时间" Padding="5,2"/>
                            <Button Grid.Column="4" Tag="Size" Click="SortHeaderClicked" Content="大小" Padding="5,2"/>
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="30"/>
                            <Setter Property="Margin" Value="6,1"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
                <Grid x:Name="SearchPane" Margin="10,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListView x:Name="SearchResults" SelectionMode="None" AutomationProperties.Name="搜索结果">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                    <TextBlock x:Name="SearchStatus" Grid.Row="1" Margin="4,6" FontSize="12" Opacity=".7"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                </Grid>
                <TextBlock x:Name="EmptyMessage" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                           Opacity=".65" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320"/>
                <Border x:Name="Notice" Margin="10" CornerRadius="10" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                        Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock x:Name="Status" Padding="10,6" FontSize="12" TextWrapping="Wrap"
                               MaxWidth="480" AutomationProperties.LiveSetting="Polite"/>
                </Border>
            </Grid>
        </Grid>
        <TextBlock x:Name="Count" Grid.Row="3" HorizontalAlignment="Right" Margin="10,0,12,8" FontSize="12" Opacity=".65"/>
    </Grid>
</Window>
